# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored on purpose: prisma/node_modules holds a stale generated client
# (from the pre-drift 43-model schema) and was previously committable.
/node_modules
**/node_modules
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# local JSON persistence adapter (server data store)
/.data

# UAT harness state — contains signed ADMIN/CUSTOMER session JWTs.
# Regenerated on every harness run; must never be committed.
/scripts/.uat-state.json
*.uat-state.json

# stale dev artifacts kept out of history
build_output.txt
.route-qa-output.txt
tailwind_dump.css
check-db.js
fix-bom.js
prisma/*.backup
prisma/*.prepas-backup-*

# dev server / build logs — may contain request paths and local URLs
*.log
*.err
dev.log
dev.err
server-out.log

# instructions for a different AI tool (Cline), not used by this repo
/.clinerules
